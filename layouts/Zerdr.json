                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "zerdr-files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "zerdr-changes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 340
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": [
            8,
            12
          ],
          "gap": 12
        }
      ],
      "resizable": false
    }
